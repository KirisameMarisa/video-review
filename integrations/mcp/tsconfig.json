{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ES2022",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./src/*"]
        },
        "strict": true,
        "noEmit": false,
        "outDir": "./dist"
    },
    "include": [
        "./*.ts"
    ]
}