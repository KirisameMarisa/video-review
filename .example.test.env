# Local test environment variables (for `npm run test:*:local`)
# Copy this file to `.env.test` and adjust values for your machine.
# `npm run test` / `npm run test:hono` will reset this database each time.

DATABASE_URL="postgresql://user:password@localhost:5432/videoreview_test"
VIDEO_REVIEW_LOCAL_ROOTDIR="/tmp/videoreview-test-uploads"

# Optional defaults to avoid missing-env behavior in some modules.
VIDEO_REVIEW_STORAGE="local"
NODE_ENV="test"

# ---------------------------------------------------------------------
#  VCS Integration (optional — tests requiring GitHub API are skipped
#  automatically when these are not set)
# ---------------------------------------------------------------------
VIDEO_REVIEW_VCS_PROVIDER="github"
VIDEO_REVIEW_VCS_GITHUB_OWNER=""
VIDEO_REVIEW_VCS_GITHUB_REPO=""
VIDEO_REVIEW_VCS_GITHUB_TOKEN=""
VIDEO_REVIEW_VCS_BRANCH="main"

# ---------------------------------------------------------------------
#  LLM Integration (optional — integration tests requiring a real LLM
#  are skipped automatically when these are not set)
# ---------------------------------------------------------------------
VIDEO_REVIEW_LLM_PROVIDER=""
VIDEO_REVIEW_LLM_API_KEY=""
VIDEO_REVIEW_LLM_BASE_URL=""
VIDEO_REVIEW_LLM_MODEL=""
